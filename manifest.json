{
  "manifest_version": 3,
  "name": "Tweakers Hide Users",
  "version": "1.4.0",
  "description": "Hide posts, quotes, tracker rows, and notifications from specific Tweakers users. Click Hide next to a name, or manage the list in the popup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tweakers Hide Users",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://tweakers.net/*",
    "https://*.tweakers.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tweakers.net/*",
        "https://*.tweakers.net/*"
      ],
      "js": [
        "boot.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "key": ""
}
